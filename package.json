{
  "name": "token-leak-finder",
  "version": "0.1.0",
  "private": true,
  "description": "Find out WHY your Claude Code / Codex limits run out. Local-only, reads logs already on disk.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "token-leak-finder": "dist/src/cli.js",
    "token-leaks": "dist/src/cli.js"
  },
  "files": [
    "dist/src/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node scripts/test.mjs",
    "start": "node dist/src/cli.js",
    "demo": "npm run build && node dist/test/fixtures/generate.js && node dist/src/cli.js --claude-dir test/fixtures/data/claude --codex-dir test/fixtures/data/codex --home-dir test/fixtures/data/home --since 30d --redact --out reports/demo.html --json reports/demo.json --rules reports/suggested-rules.md",
    "prepack": "npm run build",
    "test:package": "npm run build && node scripts/verify-package.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RomeoJuliett/token-leak-finder.git"
  },
  "homepage": "https://github.com/RomeoJuliett/token-leak-finder#readme",
  "bugs": {
    "url": "https://github.com/RomeoJuliett/token-leak-finder/issues"
  },
  "author": "Reco Jefferson",
  "keywords": [
    "claude-code",
    "codex",
    "tokens",
    "usage",
    "rate-limit",
    "llm",
    "cli",
    "mcp",
    "context-window"
  ]
}
